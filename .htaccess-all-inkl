# All-Inkl spezifische .htaccess für Kirby CMS
# Einfachste Version die funktionieren sollte

RewriteEngine On

# Verhindere Directory Listing
Options -Indexes

# Basis-Sicherheit
RewriteRule ^kirby/ - [R=404,L]
RewriteRule ^site/ - [R=404,L]
RewriteRule ^content/.*\.txt$ - [R=404,L]

# Kirby Routing - MUSS ganz am Ende stehen!
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]
