# =======================
# PHP SICHERHEIT
# =======================

# PHP-Dateien außerhalb des Webroot schützen
<Files ~ "\.php$">
    <RequireAll>
        Require all granted
    </RequireAll>
</Files>

# Backup-Dateien blockieren
<FilesMatch "\.(bak|backup|old|tmp|temp)$">
    Require all denied
</FilesMatch>
