# =======================
# KIRBY CMS 5.0 CONFIGURATION
# Optimiert für All-Inkl Shared Hosting
# =======================

# Rewrite engine aktivieren
RewriteEngine On

# =======================
# KIRBY SYSTEM SCHUTZ
# =======================

# Blockiere Zugriff auf sensible Verzeichnisse
RewriteRule ^kirby/?.*$ - [F,L]
RewriteRule ^site/?.*$ - [F,L]
RewriteRule ^content/?.*\.txt$ - [F,L]
RewriteRule ^content/?.*\.md$ - [F,L]

# Blockiere Zugriff auf Git und andere Entwicklungsdateien
RewriteRule ^\.git/?.*$ - [F,L]
RewriteRule ^\.(?:htaccess|htpasswd|env)$ - [F,L]
RewriteRule composer\.(json|lock)$ - [F,L]
RewriteRule package(-lock)?\.json$ - [F,L]
RewriteRule ^README\.md$ - [F,L]

# =======================
# KIRBY URL ROUTING
# =======================

# PANEL FIX: Ausnahme für Panel-Router
RewriteRule ^panel/?(.*)$ kirby/router.php [L]
RewriteRule ^kirby/router\.php$ - [L]

# Hauptrouting für Kirby
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L]

# Additional MIME types
AddType image/svg+xml .svg
AddType application/woff .woff
AddType application/woff2 .woff2

# pass the Authorization header to PHP
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# compress text file responses
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE text/javascript
AddOutputFilterByType DEFLATE application/json
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# PHP Memory und Upload Settings für sehr große MP3 Dateien
# Falls Server .htaccess PHP-Werte nicht unterstützt, diese Zeilen auskommentieren:
php_value memory_limit 2G
php_value upload_max_filesize 1G
php_value post_max_size 2G
php_value max_execution_time 600
php_value max_input_time 600

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
